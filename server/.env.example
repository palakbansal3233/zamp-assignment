# Copy this file to server/.env and fill in real values. Never commit .env.

# MongoDB Atlas connection string. Free tier (M0) is plenty for this project.
# Get one: https://www.mongodb.com/cloud/atlas/register -> Create free cluster
# -> Database Access (create a user) -> Network Access (allow 0.0.0.0/0 for
# a demo project) -> Connect -> Drivers -> copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zamp_assignment?retryWrites=true&w=majority

# Anthropic API key, used for document extraction and smart search.
# Get one: https://console.anthropic.com/settings/keys
# The app still runs and stores documents without this set — extraction
# just fails per-document with a clear "not configured" error, and smart
# search silently falls back to keyword search.
ANTHROPIC_API_KEY=

# Optional overrides — sensible defaults are baked into server/src/config.js.
# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=5050
# MAX_FILE_BYTES=4194304

# How long one chunk's model call may run before failing with a clear error.
# EXTRACTION_TIMEOUT_MS=45000

# How much wall-clock one upload/resume request spends reading chunks before
# returning what it has and letting the client resume. Long documents are
# read across several requests, so this stays well under any serverless
# request ceiling — see decisions.md §9.
# REQUEST_CHUNK_BUDGET_MS=30000

# How long a single /ask call may run.
# ASK_TIMEOUT_MS=25000
